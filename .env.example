# Backend propio conectado con Supabase.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Necesarias para iniciar sesión vía Supabase Auth.
# Obtener en Supabase > Project Settings > API. Nunca usar service_role en el frontend.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_SUPABASE_ANON_KEY
